# Postgres (로컬: docker compose up -d)
DATABASE_URL=postgresql://side:side@localhost:5432/side

# 네이버 뉴스 검색 Open API (https://developers.naver.com)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# OpenAI
OPENAI_API_KEY=
# Structured Outputs 확장 제약(minItems/maxItems 등)을 지원하는 최신 모델을 써야 한다.
# 구 스냅샷 모델은 스키마를 거부하며 400 을 돌려준다.
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 관리자 검수 (/admin)
ADMIN_PASSWORD=
# 쿠키 서명용 임의 문자열 (openssl rand -hex 32)
ANON_COOKIE_SECRET=
