# Postgres (로컬: docker compose up -d)
DATABASE_URL=postgresql://side:side@localhost:5432/side

# NAVER API HUB (https://www.ncloud.com 에서 NCP 계정 → NAVER API HUB 이용 신청 → 검색 API 키 발급)
# 개발자센터 키(구)는 2026-07-31 이후 사용 불가능
NCP_APIGW_API_KEY_ID=
NCP_APIGW_API_KEY=

# OpenAI
OPENAI_API_KEY=
# Structured Outputs 확장 제약(minItems/maxItems 등)을 지원하는 최신 모델을 써야 한다.
# 구 스냅샷 모델은 스키마를 거부하며 400 을 돌려준다.
OPENAI_TEXT_MODEL=gpt-5.4-mini
# 분류(classify) 전용 저가 모델. 넓게 걸러내는 단계만 이 모델을 쓴다.
OPENAI_NANO_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 파이프라인 임계값 (docs/PipelineTieringSpec.md 2장)
# classify 통과 점수(0~100). 미달 이슈는 AUTO_REJECTED 로 자동 제외한다.
PIPELINE_DEBATE_THRESHOLD=60
# 실행 1회에 요약·추출까지 진행할 이슈 수 상한(점수 내림차순).
PIPELINE_EXPOSE_LIMIT=10

# 관리자 검수 (/admin)
ADMIN_PASSWORD=
# 쿠키 서명용 임의 문자열 (openssl rand -hex 32)
ANON_COOKIE_SECRET=
